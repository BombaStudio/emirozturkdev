# Telegram Bot API credentials for contact form submissions
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Keystatic CMS Configuration
# Required for local/production admin access at /keystatic
KEYSTATIC_REPO="owner/repo"
KEYSTATIC_SECRET="your_keystatic_secret_32_bytes_here"
KEYSTATIC_GITHUB_CLIENT_ID="your_github_oauth_client_id"
KEYSTATIC_GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG="your_github_app_slug"

# Webhooks and Site URL
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
